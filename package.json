{
  "name": "fcp-sfd-doc-upload-api-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=22.22.0"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "npm run clean && cucumber-js",
    "test:tag": "cucumber-js --tags",
    "test:dry": "cucumber-js --dry-run",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:parallel": "npm run clean && cucumber-js --parallel 4",
    "format": "prettier --write \"**/*.{js,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,md,json}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh",
    "check:synthetic-ids": "sfd-id-check --staged"
  },
  "dependencies": {
    "@cucumber/cucumber": "13.2.0",
    "allure-commandline": "2.32.0",
    "allure-cucumberjs": "3.0.0",
    "dotenv": "17.4.2",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "fcp-sfd-core": "github:DEFRA/fcp-sfd-core#95f58ade56b2d0dd0f15bdcba6a5f37a54bcc939",
    "husky": "9.1.7",
    "prettier": "3.4.2"
  }
}
