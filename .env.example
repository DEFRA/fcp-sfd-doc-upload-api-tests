OBJECT_PROCESSOR_URL=
COGNITO_TOKEN_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
TEST_USER_SBI=
TEST_USER_CRN=
TEST_USER_FRN=
TEST_S3_BUCKET=

# Read-only Dataverse access, used by the @crm scenarios only. Leave blank to
# skip those scenarios. Dataverse is an external host, so the runner also
# needs the proxy below and egress to the Dataverse host allowed.
CRM_API_BASE_URL=
CRM_AUTH_ENDPOINT=
CRM_AUTH_CLIENT_ID=
CRM_AUTH_CLIENT_SECRET=
CRM_AUTH_SCOPE=

# The CDP Squid proxy. Deployed containers already have this set, so leave it
# blank there. Set it only when running locally against a CDP environment.
HTTPS_PROXY=http://localhost:3128
